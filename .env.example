# MySQL connection string — update with your actual credentials.
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/insightiq

# JWT signing secret — replace with a long random string before deploying.
SECRET_KEY=replace-with-a-long-random-secret-string

# JWT token lifetime in minutes (default 60)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Seeded admin account — created automatically on first startup.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=insightiq2026
